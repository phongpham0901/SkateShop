@using Microsoft.AspNetCore.Html;
@model List<Category>
@{
    int pageIndex = (int)ViewData["PageIndex"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    string search = (string)ViewData["Search"]!;
}

<h2 class="text-center mb-4">List of Categories</h2>

<div class="row mb-4 align-items-center">
    <!-- Nút tạo danh mục -->
    <div class="col-md-6">
        <a class="btn btn-primary" asp-controller="Category" asp-action="Create">
            <i class="bi bi-plus-circle"></i> New Category
        </a>
    </div>

    <!-- Ô tìm kiếm -->
    <div class="col-md-6">
        <form class="d-flex" role="search">
            <input class="form-control me-2" type="search" name="search" value="@search"
                   placeholder="Search by Name..." aria-label="Search">
            <button class="btn btn-outline-success" type="submit">
                <i class="bi bi-search"></i> Search
            </button>
        </form>
    </div>
</div>

<!-- Bảng danh mục -->
<div class="table-responsive">
    <table class="table table-hover text-center align-middle">
        <thead class="table-success">
            <tr>
                <th style="width: 10%;">ID</th>
                <th style="width: 20%;">Name</th>
                <th style="width: 30%;">Description</th>
                <th style="width: 20%;">Created At</th>
                <th style="width: 20%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.Name</td>
                    <td>@a.Des</td>
                    <td>@a.CreatedAt</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-controller="Category" asp-action="Edit" asp-route-id="@a.Id">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a class="btn btn-sm btn-danger" asp-controller="Category" asp-action="Delete" asp-route-id="@a.Id"
                           onclick="return confirm('Are you sure you want to delete this category?')">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
@if (totalPages > 1)
{
    <nav class="d-flex justify-content-center">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageIndex ? "active" : "")">
                    <a class="page-link" asp-route-pageIndex="@i" asp-route-search="@search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
