@model Product

@{
}

<div class="row">
    <div class="col-md-4 text-center">
        <img src="/products/@Model.ImageFileName" class="img-fluid mb-3" alt="..." width="250" />
    </div>
    <div class="col-md-8">
        <h3 class="mb-3">@Model.Name</h3>
        <h3 class="mb-3">@(Model.Price)$</h3>
        <button type="button" class="btn btn-warning btn-sm" onclick="addToCart(this, @Model.Id)">
            Add to Cart <i class="bi bi-cart-plus"></i>
        </button>

        <hr />

        <div class="row mb-3">
            <div class="col-sm-3 fw-bold">
                Brand
            </div>
            <div class="col-sm-9">
                @Model.Brand
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-3 fw-bold">
                Material
            </div>
            <div class="col-sm-9">
                @Model.Material
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-3 fw-bold">
                Size
            </div>
            <div class="col-sm-9">
                @Model.Size
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-3 fw-bold">
                Type
            </div>
            <div class="col-sm-9">
                @Model.Type
            </div>
        </div>

    </div>
</div>

@* Đánh Giá *@
<div class="mt-4">
    <h4>Customer Reviews</h4>
    <hr />

    @if (ViewBag.Assessments != null && ((List<Assess>)ViewBag.Assessments).Count > 0)
    {
        @foreach (var assess in ViewBag.Assessments)
        {
            <div class="border rounded p-2 mb-2">
                <div>
                    <strong>Name:</strong> @assess.Name
                </div>
                <div>
                    <strong>Rating:</strong>
                    <div class="stars" data-rating="@assess.start"></div> @* Sử dụng JS để hiển thị sao *@
                </div>
                <div>
                    <strong>Comment:</strong> @assess.Description
                </div>
            </div>
        }
    }
    else
    {
        <p>No reviews yet. Be the first to review this product!</p>
    }
</div>


<div class="row mb-5">
    <div class="col">
        <a class="btn btn-primary" asp-controller="Store" asp-action="AddAssess" asp-route-id="@ViewBag.Assess.Id">Add Assess</a>
    </div>
</div>

<script>
    // JavaScript để hiển thị số sao
    document.addEventListener("DOMContentLoaded", function () {
        const starContainers = document.querySelectorAll(".stars");

        starContainers.forEach(function (container) {
            const rating = parseInt(container.getAttribute("data-rating")); // Lấy rating từ data-rating
            let starsHtml = "";

            for (let i = 0; i < rating; i++) {
                starsHtml += '<i class="bi bi-star-fill text-warning"></i>'; // Sao vàng
            }
            for (let i = rating; i < 5; i++) {
                starsHtml += '<i class="bi bi-star text-secondary"></i>'; // Sao xám
            }

            container.innerHTML = starsHtml;
        });
    });

</script>
