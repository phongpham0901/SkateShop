﻿@using Microsoft.AspNetCore.Html;
@model List<Articlecs>
@{
    int pageIndex = (int)ViewData["PageIndex"]!;
    int totalPages = (int)ViewData["TotalPages"]!;

    string search = (string)ViewData["Search"]!;

}

<h2 class="text-center mb-5">List of Articlecs</h2>

<div class="row mb-5">
    <div class="col">
        <div>
            <a class="btn btn-primary" asp-controller="Articlecs" asp-action="Create">New Articlec</a>
        </div>

    </div>

    <div class="col">
        <form class="d-flex" role="search">
            <input class="form-control me-2" type="search" name="search" value="@search" placeholder="Search by Title " aria-label="Search">
            <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
    </div>
</div>

<table class="table">
    <thead class="table-success">
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Content</th>
            <th>Image</th>
            <th>Created At</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Title</td>
                <td>@a.Content</td>
                <td><img src="/articlecs/@a.ImageFileName" width="100" /></td>
                <td>@a.CreatedAt.ToString("MM/dd/yyyy")</td>
                <td style="white-space:nowrap">
                    <a class="btn btn-primary btn-sm" asp-controller="Articlecs" asp-action="Edit"
                       asp-route-id="@a.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-controller="Articlecs" asp-action="Delete"
                       asp-route-id="@a.Id" onclick="return confirm('Are you sure?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= totalPages; i++)
        {
            string active = "";
            if (i == pageIndex) active = "active";
            <li class="page-item @active">
                <a class="page-link" asp-route-pageIndex="@i"
                   asp-route-search="@search">@i</a>
            </li>
        }
    </ul>
</nav>
